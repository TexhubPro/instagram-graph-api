{
    "name": "texhub/instagram-graph-api",
    "description": "Full-featured Instagram Graph API SDK for any PHP framework with first-class Laravel support: OAuth & long-lived tokens, content publishing, stories, comments, direct messaging with buttons, user info and webhooks.",
    "type": "library",
    "keywords": ["php", "laravel", "instagram", "instagram-graph-api", "instagram-api", "messaging", "webhooks", "meta", "texhub"],
    "homepage": "https://texhub.pro",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahmudi Shodmehr",
            "email": "info@texhub.pro",
            "homepage": "https://texhub.pro",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://texhub.pro",
        "docs": "https://developers.facebook.com/docs/instagram-platform"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "TexHub\\InstagramGraphApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TexHub\\InstagramGraphApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TexHub\\InstagramGraphApi\\Laravel\\InstagramServiceProvider"
            ],
            "aliases": {
                "Instagram": "TexHub\\InstagramGraphApi\\Laravel\\Instagram"
            }
        }
    },
    "suggest": {
        "illuminate/support": "Required to use the package inside a Laravel application (service provider, facade, config publishing)."
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
